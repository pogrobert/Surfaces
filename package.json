{
  "name": "@pogrobert/surfaces",
  "version": "0.1.3",
  "description": "Covers, link previews and headers for every page of a site, drawn by code from one brand colour. No AI and no API key: the same title always gives the same picture.",
  "keywords": [
    "generative-art",
    "cover",
    "og-image",
    "open-graph",
    "link-preview",
    "social-card",
    "banner",
    "svg",
    "brand",
    "deterministic",
    "react",
    "agents"
  ],
  "homepage": "https://surfaces.pogrobert.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pogrobert/surfaces.git"
  },
  "bugs": {
    "url": "https://github.com/pogrobert/surfaces/issues"
  },
  "author": {
    "name": "Robert Poghosyan",
    "url": "https://pogrobert.com"
  },
  "license": "MIT-0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "default": "./dist/png.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./schema.json": "./dist/schema.json",
    "./*/react": {
      "types": "./dist/style/*/react.d.ts",
      "default": "./dist/style/*/react.js"
    },
    "./*": {
      "types": "./dist/style/*.d.ts",
      "default": "./dist/style/*.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "LICENSE",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "docs/api.md",
    "docs/colour.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && node scripts/style-entries.ts && tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json && node scripts/schema.ts",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test --test-concurrency=4 test/*.test.ts",
    "test:full": "SURFACES_FULL=1 pnpm test",
    "golden": "UPDATE_GOLDEN=1 node --test --test-concurrency=1 test/determinism.test.ts",
    "sheet": "pnpm build && node scripts/contact-sheet.ts",
    "sheet:serve": "node scripts/serve-sheet.ts",
    "studio": "pnpm build && node scripts/serve-sheet.ts",
    "site": "pnpm build && pnpm --filter surfaces-site dev",
    "bench:motion": "pnpm build && node scripts/bench-motion.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@resvg/resvg-js": ">=2.6.2",
    "@resvg/resvg-wasm": ">=2.6.2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@resvg/resvg-wasm": {
      "optional": true
    }
  },
  "sideEffects": false,
  "bin": {
    "surfaces": "dist/cli.js"
  }
}
